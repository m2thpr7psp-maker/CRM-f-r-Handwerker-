# HandwerkOS – Umgebungsvariablen (Kopie als .env anlegen)
# Alle Werte sind optional; ohne .env läuft die App komplett lokal
# mit dem Console-Provider (Nachrichten werden nur geloggt).

# --- Terminanfragen-Modul (Fritz) ---

# Nachrichten-Versand: "console" (Standard, loggt nur) oder "twilio"
NACHRICHTEN_PROVIDER=console

# Twilio-Zugangsdaten für SMS-Versand (nur bei NACHRICHTEN_PROVIDER=twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Absicherung des Anfrage-Webhooks (POST /api/anfragen):
# Wenn gesetzt, muss der Aufrufer den Header "x-webhook-secret" mitschicken.
ANFRAGEN_WEBHOOK_SECRET=

# Absicherung der Cron-Route (GET /api/cron/nachrichten):
# Wenn gesetzt, ist "Authorization: Bearer <Wert>" erforderlich.
CRON_SECRET=
