generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Kunde {
  id         String    @id @default(cuid())
  name       String
  firma      String?
  strasse    String?
  plz        String?
  ort        String?
  telefon    String?
  email      String?
  notizen    String?
  erstelltAm DateTime  @default(now())
  auftraege  Auftrag[]
  anfragen   TerminAnfrage[]
}

/// Fritz: telefonisch (oder manuell/web) erfasste Terminanfrage
model TerminAnfrage {
  id             String       @id @default(cuid())
  kundeName      String
  telefon        String
  adresse        String?
  anliegen       String
  dringlichkeit  String       @default("NORMAL") // NOTFALL | DRINGEND | NORMAL
  wunschZeitraum String?
  quelle         String       @default("TELEFON") // TELEFON | WEB | MANUELL
  status         String       @default("NEU") // NEU | VORGESCHLAGEN | BESTAETIGT | ABGELEHNT | ERLEDIGT
  createdAt      DateTime     @default(now())
  kundeId        String?
  kunde          Kunde?       @relation(fields: [kundeId], references: [id], onDelete: SetNull)
  slots          TerminSlot[]
  nachrichten    Nachricht[]
}

model TerminSlot {
  id         String        @id @default(cuid())
  anfrageId  String
  anfrage    TerminAnfrage @relation(fields: [anfrageId], references: [id], onDelete: Cascade)
  datum      DateTime
  uhrzeitVon String
  uhrzeitBis String
  status     String        @default("VORGESCHLAGEN") // VORGESCHLAGEN | GEWAEHLT | VERWORFEN
}

/// Zeitfenster, in denen der Betrieb grundsätzlich Termine annimmt.
/// wochentag: 0 = Montag … 6 = Sonntag
model VerfuegbarkeitsFenster {
  id        String  @id @default(cuid())
  wochentag Int
  von       String
  bis       String
  aktiv     Boolean @default(true)
}

model Nachricht {
  id         String        @id @default(cuid())
  anfrageId  String
  anfrage    TerminAnfrage @relation(fields: [anfrageId], references: [id], onDelete: Cascade)
  kanal      String        @default("SMS") // SMS | WHATSAPP
  typ        String // EINGANG_BESTAETIGT | TERMIN_BESTAETIGT | ERINNERUNG | ABSAGE
  inhalt     String
  telefon    String
  faelligAt  DateTime      @default(now())
  gesendetAt DateTime?
  status     String        @default("GEPLANT") // GEPLANT | GESENDET | FEHLER
}

model Auftrag {
  id           String     @id @default(cuid())
  kundeId      String
  kunde        Kunde      @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  titel        String
  beschreibung String?
  status       String     @default("ANFRAGE")
  erstelltAm   DateTime   @default(now())
  termine      Termin[]
  rechnungen   Rechnung[]
}

model Mitarbeiter {
  id      String   @id @default(cuid())
  name    String
  farbe   String   @default("#2563eb")
  termine Termin[]
}

model Termin {
  id            String       @id @default(cuid())
  auftragId     String
  auftrag       Auftrag      @relation(fields: [auftragId], references: [id], onDelete: Cascade)
  datum         DateTime
  startZeit     String
  endZeit       String
  mitarbeiterId String?
  mitarbeiter   Mitarbeiter? @relation(fields: [mitarbeiterId], references: [id], onDelete: SetNull)
  ort           String?
  notiz         String?
}

model Rechnung {
  id               String              @id @default(cuid())
  nummer           String              @unique
  auftragId        String
  auftrag          Auftrag             @relation(fields: [auftragId], references: [id], onDelete: Cascade)
  datum            DateTime            @default(now())
  leistungVon      DateTime?
  leistungBis      DateTime?
  mwstSatz         Float               @default(19)
  zahlungszielTage Int                 @default(14)
  /// Leitweg-ID (Behörden) oder Bestell-/Referenznummer des Kunden (BT-10 in der XRechnung)
  kaeuferReferenz  String?
  positionen       RechnungsPosition[]
}

model RechnungsPosition {
  id          String   @id @default(cuid())
  rechnungId  String
  rechnung    Rechnung @relation(fields: [rechnungId], references: [id], onDelete: Cascade)
  bezeichnung String
  menge       Float
  einheit     String   @default("Std.")
  einzelpreis Float
  sortierung  Int      @default(0)
}

model Einstellungen {
  id           Int     @id @default(1)
  firmenname   String  @default("")
  strasse      String  @default("")
  plz          String  @default("")
  ort          String  @default("")
  telefon      String  @default("")
  email        String  @default("")
  steuernummer String  @default("")
  ustIdNr      String  @default("")
  iban         String  @default("")
  logo         String?
  stundensatz  Float   @default(55)
  /// Kleinunternehmerregelung nach § 19 UStG: keine Umsatzsteuer ausweisen
  kleinunternehmer Boolean @default(false)
  pinHash      String?
  pinSalz      String?
}
